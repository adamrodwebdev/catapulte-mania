{
  "name": "catapulte-mania",
  "version": "5.6.1",
  "private": true,
  "description": "Jeu de catapulte médiéval 100 % front-end (Vue 3 + Vite + Matter.js) : 40 niveaux, pouvoirs spéciaux, multilingue (FR / EN / ID) et accessible.",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "build:crazygames": "vite build --mode crazygames",
    "build:crazygames:basic": "node -e \"process.env.CTC_ADS='off';require('child_process').execSync('vite build --mode crazygames',{stdio:'inherit',env:process.env})\"",
    "build:poki": "vite build --mode poki",
    "build:gamedistribution": "vite build --mode gamedistribution",
    "build:gamepix": "vite build --mode gamepix",
    "build:y8": "vite build --mode y8",
    "build:standalone": "vite build --mode standalone",
    "release:portals": "node scripts/release-portals.mjs",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.js\"",
    "check:levels": "node scripts/check-levels.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.1.0",
    "vite": "^8.3.0"
  }
}
